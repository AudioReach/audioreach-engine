#===============================================================================
#
# GENERAL DESCRIPTION
#    Build script
#
#
#===============================================================================

Import('env')
import os
# flags to adjust the compiler optimizations
#env.Append(CPPFLAGS = ' -O0')
#env.Append(CFLAGS = ' -O0')

#-------------------------------------------------------------------------------
# Setup source PATH
#-------------------------------------------------------------------------------

LIBNAME = 'detection_engine_exmp_module'

items = env.GetSoftwareUnits()
 
x = items.get('LIBS')

avs_reg_sources = []
avs_stub_sources = []
avs_fwk_sources = list(x)
island_sources = []
island_stub_sources  = []
island_prop_sources = []

for i in x: 
    
    if i.name == 'capi_detection_engine.lib':
        avs_reg_sources.append(i)
        avs_fwk_sources.remove(i)
    if i.name == 'capi_detection_engine_island.lib':
        island_sources.append(i)
        avs_fwk_sources.remove(i)
    if "_stub" in i.name:
        avs_stub_sources.append(i)
        avs_fwk_sources.remove(i)
        
core_public_apis = [
 'DEBUGTOOLS',
 'SERVICES',
 'KERNEL',
]

env.RequirePublicApi(core_public_apis, area='core')
env.RequireRestrictedApi(['SHARED_LIBRARY_INC_PATHS'])
    
platform_public_apis = [
  'STDDEF', # AEEDef
  'HAPSDK', # HAP_debug, farf etc
    ]

# This has to be the last include command, so that the Elite_CAPI.h and Elite_APPI.h are not overridden
env.RequirePublicApi(platform_public_apis, area='platform')

## for shared libraries

if 'USES_AUDIO_IN_ISLAND' in env and 'USES_DETECTION_ENGINE_TOUSE_CDC_CTRL_MIC_SWITCH' in env:
    print('detection engine scons dbg - in island cond')
    get_island_lib = env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME+'_island',
                                       [island_sources, island_stub_sources , island_prop_sources],'MOD', PACK_SRC=True)
    if 'USES_AVS_LIBRARY_BUILDER' in env:
         x = env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME,
                               [avs_reg_sources, avs_stub_sources, avs_fwk_sources],'MOD', PACK_SRC=True)
else:
     if 'USES_AVS_LIBRARY_BUILDER' in env:   
         print('detection engine scons dbg - in avs lib builder cond')
         x = env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME,
                               [avs_reg_sources, avs_stub_sources, avs_fwk_sources],'MOD', PACK_SRC=True)

if 'USES_DETECTION_ENGINE_TOUSE_CDC_CTRL_MIC_SWITCH' in env:
   env.Append(H2XML_MACRO="USES_DETECTION_ENGINE_TOUSE_CDC_CTRL_MIC_SWITCH")
   if os.path.exists("${INC_ROOT}/gpr/platform"):
      env.Append(H2XML_INC_PATH = "${INC_ROOT}/gpr/platform/qurt/osal/api ")
   else:
      env.Append(H2XML_INC_PATH = "${INC_ROOT}/gpr/core/ar_osal/qurt/api ")
   env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/ar_utils ")
   env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/apm ")
   env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/modules ")
   env.Append(H2XML_INC_PATH = "${INC_ROOT}/${AVS_AU_NAME}/fwk/spf/interfaces/module/imcl/api ")
   env.H2xmlFileGenerate(env.subst('../api/detection_engine_api.h'))
   
