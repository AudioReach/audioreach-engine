Import('env')
import os
#---------------------------- h2xml generation --------------------------
env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/ar_utils ")
env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/modules ")
env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/apm ")
if os.path.exists("${INC_ROOT}/gpr/platform"):
	env.Append(H2XML_INC_PATH = "${INC_ROOT}/gpr/platform/qurt/osal/api ")
else:
	env.Append(H2XML_INC_PATH = "${INC_ROOT}/gpr/core/ar_osal/qurt/api ")

env.H2xmlFileGenerate(env.subst('../api'))
#---------------------------- h2xml generation --------------------------
#-------------------------------------------------------------------------------
# Setup source PATH
#-------------------------------------------------------------------------------
LIBNAME = 'shmem_example_module'

items = env.GetSoftwareUnits()

x = items.get('LIBS')

avs_reg_sources = list(x)
avs_stub_sources = []
avs_fwk_sources = []


for i in x:

    if "_stub" in i.name:
        avs_stub_sources.append(i)
        avs_reg_sources.remove(i)

core_public_apis = [
 'DEBUGTOOLS',
 'SERVICES',
 'KERNEL',
]

env.RequirePublicApi(core_public_apis, area='core')
env.RequireRestrictedApi(['SHARED_LIBRARY_INC_PATHS'])

platform_public_apis = [
  'STDDEF', # AEEDef
  'HAPSDK', # HAP_debug, farf etc
    ]

# This has to be the last include command, so that the Elite_CAPI.h and Elite_APPI.h are not overridden
env.RequirePublicApi(platform_public_apis, area='platform')
if env.get('OEM_ROOT'):
    bucket = 'HAP_AVS_ADSP'
else:
    bucket = "AVS_SHARED"

## for shared libraries
if 'USES_AVS_SHARED_LIBS' in env:
    SRCPATH='..'
    env.VariantDir('${BUILDPATH}', SRCPATH, duplicate=0)
    env.AddAvsSharedLibrary(bucket, '${BUILDPATH}/'+LIBNAME,
                            [avs_reg_sources, avs_stub_sources, avs_fwk_sources], build_type='MOD',PACK_SRC= True)
else:
     if 'USES_AVS_LIBRARY_BUILDER' in env:
         x = env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME,
                               [avs_reg_sources, avs_stub_sources, avs_fwk_sources],'MOD', PACK_SRC = True)
