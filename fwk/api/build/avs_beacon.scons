'''
/*==============================================================================
@file avs_beacon.scons
@brief 
================================================================================
==============================================================================*/
'''

Import('env')
import os

env.LoadSoftwareUnits()

platform_public_apis = [
    'STDDEF', # AEEDef
    'HAPSDK', # HAP_debug, farf etc
]


# This has to be the last include command, so that the Elite_CAPI.h and Elite_APPI.h are not overridden
env.RequirePublicApi(platform_public_apis, area='platform')

#### H2xml ####
#includes
env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/ar_utils ")
env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/modules ")
env.Append(H2XML_INC_PATH = "${AVS_ROOT}/api/apm ")
if os.path.exists("${INC_ROOT}/gpr/platform"):
	env.Append(H2XML_INC_PATH = "${INC_ROOT}/gpr/platform/qurt/osal/api ")
else:
	env.Append(H2XML_INC_PATH = "${INC_ROOT}/gpr/core/ar_osal/qurt/api ")
#env.Append(H2XML_INC_PATH = "${INC_ROOT}/platform/inc/HAP ")
#env.Append(H2XML_INC_PATH = "${INC_ROOT}/core/api/services ")

#Can be removed once multi component is up.
#Backward compatible
env.Append(H2XML_INC_PATH = "${INC_ROOT}/${AVS_AU_NAME}/spm/encdec/pcm_decoder/api ")
env.Append(H2XML_INC_PATH = "${INC_ROOT}/${AVS_AU_NAME}/spm/api ")
#env.Append(H2XML_INC_PATH = "${AVS_ROOT}/utest/modules/backend/inc ")

env.Append(H2XML_INC_PATH = "${INC_ROOT}/${AVS_AU_NAME}/spm/aud/pcm_decoder/api ")
env.Append(H2XML_INC_PATH = "${INC_ROOT}/${AVS_AU_NAME}/spm/cmn/api ")

env.RequirePublicApi('GPR', area='gpr')

# NEWLY ADDED COMMENTS - START
env.H2xmlFileGenerate(env.subst('${AVS_ROOT}/api/modules'))
env.H2xmlFileGenerate(env.subst('${AVS_ROOT}/api/apm'), True) #True for building spfProp xml
env.H2xmlFileGenerate(env.subst('${AVS_ROOT}/api/vcpm/vcpm_config_api.h'), "VCPMModule")
env.H2xmlFileGenerate(env.subst('${AVS_ROOT}/api/vcpm/vcpm_api.h'), "Key")
# END
