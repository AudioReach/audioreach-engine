'''
/*==============================================================================
@file audio_dam_buffer_capi.scons
@brief

==============================================================================*/

'''

Import('env')

if 'USES_ENABLE_FUNCTION_SECTIONS' in env:
   env.Append(CFLAGS = '-ffunction-sections')

core_public_apis = [
   'DEBUGTOOLS',
   'SERVICES',
   'KERNEL',
   ]

env.RequirePublicApi(core_public_apis, area='core')
env.RequireRestrictedApi(['AVS', 'SHARED_LIBRARY_INC_PATHS'])
env.RequireRestrictedApi('SVA_COMMON_SHARED_INCS')
env.RequireProtectedApi('AVS')
env.PublishPrivateApi('AVS',[
   '../inc',
   '../../lib/inc',
   ])

#-------------------------------------------------------------------------------
# Setup source PATH
#-------------------------------------------------------------------------------
SRCPATH = '..'
LIBNAME = 'capi_audio_dam_buffer'
LIBNAME_STUB = LIBNAME+'_stub'

env.VariantDir('${BUILDPATH}', SRCPATH, duplicate=0)

avs_sources = env.GlobSourceFiles(['src/*.c'], SRCPATH,posix=True)
avs_stub_sources = env.GlobSourceFiles(['stub_src/*.c'], SRCPATH,posix=True)
avs_fwk_sources = []

platform_public_apis = [
  'STDDEF', # AEEDef
  'HAPSDK', # HAP_debug, farf etc
    ]

# This has to be the last include command, so that the Elite_CAPI.h and Elite_APPI.h are not overridden
env.RequirePublicApi(platform_public_apis, area='platform')

bucket= ['AVS_ADSP','AVS_ADSP_USER']
if 'USES_AVS_SHARED_LIBS' in env:
    bucket = 'AVS_SHARED'

if 'USES_AUDIO_IN_ISLAND' in env:
     if 'USES_RAW_DATA_STREAM_ISLAND' in env:
   #raw data stream usecases (write and read)
       non_island_reg_sources,island_reg_sources = env.IslandFilter(avs_sources)
       non_island_stub_sources,island_stub_sources = env.IslandFilter(avs_stub_sources)
     else:
   #sva usecases (no read_island)
       island_reg_sources = list(set(env.IslandFilter(avs_sources)[1]) - set(env.AvsPatternFilter(avs_sources, "*_read_island*")[1]))
       non_island_reg_sources = list(set(avs_sources) - set(island_reg_sources))
       island_stub_sources = list(set(env.IslandFilter(avs_stub_sources)[1]) - set(env.AvsPatternFilter(avs_stub_sources, "*_read_island*")[1]))
       non_island_stub_sources = list(set(avs_stub_sources) - set(island_stub_sources))

     if 'USES_DAM_OUTPUT_CTRL_NLPI' in env:
    # Remove island_reg_sources that match the pattern "*_output_ctrl_island*"
       island_sources_to_remove = set(env.AvsPatternFilter(island_reg_sources, "*_output_ctrl_island*")[1])
       island_reg_sources = list(set(island_reg_sources) - island_sources_to_remove)
    # Add the same sources to non_island_reg_sources
       non_island_reg_sources.extend(island_sources_to_remove)
    # Stub sources
       island_stub_sources_to_remove = set(env.AvsPatternFilter(island_stub_sources, "*_output_ctrl_island*")[1])
       island_stub_sources = list(set(island_stub_sources) - island_stub_sources_to_remove)
       non_island_stub_sources.extend(island_stub_sources_to_remove)

     if 'USES_AVS_LIBRARY_BUILDER' in env:
       env.AddLibrary(bucket, '${BUILDPATH}/'+LIBNAME,
       [non_island_reg_sources], PACK_SRC=True)
     get_island_lib = env.AddLibrary(bucket, '${BUILDPATH}/'+LIBNAME+'_island',[ island_reg_sources], PACK_SRC=True)
     if 'USES_MEMSEG' in env:
       env.TagLibraryForMemorySegment(bucket, 'va', get_island_lib)
     elif 'USES_ISLAND' in env:
       env.AddIslandLibrary(bucket, get_island_lib)
else:
     env.AddLibrary(bucket, '${BUILDPATH}/'+LIBNAME, avs_sources)
     env.AddLibrary(bucket, '${BUILDPATH}/'+LIBNAME_STUB, avs_stub_sources)
