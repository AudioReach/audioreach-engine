'''
/*==============================================================================
@file capi.scons
@brief 

==============================================================================*/

'''

Import('env')

core_public_apis = [
   'DEBUGTOOLS',
   'KERNEL',
   'POWER',
   'SERVICES',
   ]
   
platform_public_apis = [
  'STDDEF', # AEEDef
  'HAPSDK', # HAP_debug, farf etc
    ]   

env.RequirePublicApi(core_public_apis, area='core')
env.RequirePublicApi(platform_public_apis, area='platform')
env.RequireRestrictedApi(['AVS', 'SHARED_LIBRARY_INC_PATHS'])

env.PublishPrivateApi('AVS_MUX_DEMUX',[
   '../inc',
   '../../api'
   ])

#-------------------------------------------------------------------------------
# Setup source PATH
#-------------------------------------------------------------------------------
SRCPATH = '..'
LIBNAME = 'capi_mux_demux'
LIBNAME_STUB = LIBNAME+'_stub'
#env.Replace(HEXAGONCC_OPT = "-O0")

#import pdb; pdb.set_trace()

env.VariantDir('${BUILDPATH}', SRCPATH, duplicate=0)
avs_reg_sources = env.GlobSourceFiles(['src/*.cpp', 'src/*.c'], SRCPATH,posix=True)
avs_stub_sources = env.GlobSourceFiles(['stub_src/*.cpp', 'stub_src/*.c'], SRCPATH,posix=True)
avs_fwk_sources = []

if 'USES_AUDIO_IN_ISLAND' in env:
    non_island_sources,island_sources = env.IslandFilter(avs_reg_sources)
    env.AddLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME, non_island_sources)
    get_island_lib = env.AddLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME+'_island', [island_sources])
    #if 'USES_MEMSEG' in env:
       #env.TagLibraryForMemorySegment(['AVS_ADSP','AVS_ADSP_USER'], 'va', get_island_lib)
    if 'USES_ISLAND' in env:
       env.AddIslandLibrary(['AVS_ADSP','AVS_ADSP_USER'], get_island_lib)	   
else:
  
    env.AddLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME, avs_reg_sources) 
    env.AddLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME_STUB, avs_stub_sources)
