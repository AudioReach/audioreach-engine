'''
/*==============================================================================
@file capi_ipc_rx.scons
@brief 
==============================================================================*/

'''

Import('env')

if 'USES_ENABLE_FUNCTION_SECTIONS' in env:
   env.Append(CFLAGS = '-ffunction-sections')

core_public_apis = [
   'DEBUGTOOLS',
   'SERVICES',
   'KERNEL',
   ]

env.RequirePublicApi(core_public_apis, area='core')
env.RequireRestrictedApi(['AVS', 'SHARED_LIBRARY_INC_PATHS', 'CAPI_CMN_LIB'])
env.RequireProtectedApi('AVS')

env.PublishPrivateApi('AVS', [
    '${AVS_ROOT}/spf/modules/ipc_rx/api',
	'${AVS_ROOT}/spf/modules/ipc_rx/capi/inc',
])


#-------------------------------------------------------------------------------
# Setup source PATH
#-------------------------------------------------------------------------------
SRCPATH = '..'
LIBNAME = 'capi_ipc_rx'
LIBNAME_STUB = LIBNAME+'_stub'

#import pdb; pdb.set_trace()

env.VariantDir('${BUILDPATH}', SRCPATH, duplicate=0)
avs_reg_sources = env.GlobSourceFiles(['src/*.cpp','src/*.c'], SRCPATH,posix=True)
avs_stub_sources = env.GlobSourceFiles(['stub_src/*.cpp','stub_src/*.c'], SRCPATH,posix=True)
avs_fwk_sources = []

env.RequireRestrictedApi(['SHARED_LIBRARY_INC_PATHS'])

#import pdb; pdb.set_trace()
env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME, [avs_reg_sources, avs_stub_sources, avs_fwk_sources])
