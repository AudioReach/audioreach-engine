'''
/*==============================================================================
@file utils.scons
@brief

==============================================================================*/

'''

Import('env')

from glob import glob
from os.path import join, basename

if 'CSMD_COSIM' in env:
  env.Append(CPPFLAGS = '-DCSMD_COSIM ')
  env.Append(CFLAGS = '-DCSMD_COSIM ')

env.Append(CPPFLAGS = '-DDEBUG_SPF_BUFMGR')
env.Append(CFLAGS = '-DDEBUG_SPF_BUFMGR')

CBSP_API = [
   'BOOT',
   'DAL',
   'DEBUGTOOLS',
   'HAL',
   'MPROC',
   'POWER',
   'SERVICES',
   'SYSTEMDRIVERS',

   # needs to be last also contains wrong comdef.h
   'KERNEL',
]

env.RequirePublicApi(CBSP_API,area='core')
env.RequireRestrictedApi('AVS')
env.RequireProtectedApi('AVS')

platform_public_apis = [
    'QAIC',
    'STDDEF',
    'HAPSDK'
    ]

env.RequirePublicApi([
  'AMDB',
])

# This has to be the last include command, so that the Elite_CAPI.h and Elite_APPI.h are not overridden
env.RequirePublicApi(platform_public_apis, area='platform')

env.PublishPrivateApi('AVS',[
   '${AVS_ROOT}/spf/utils/cmn/inc',
   '${AVS_ROOT}/spf/utils/cmn/api',
   ])

#-------------------------------------------------------------------------------
# Setup source PATH
#-------------------------------------------------------------------------------
SRCPATH = "${AVS_ROOT}/spf/utils/cmn/"
LIBNAME = 'spf_utils'

env.VariantDir('${BUILDPATH}', SRCPATH, duplicate=0)

srcpath = env.RealPath(SRCPATH, posix=True)
avs_reg_sources = env.GlobFiles([srcpath+'/src/*.cpp', srcpath+'/src/*.c', srcpath+'/tst/*.cpp', srcpath+'/tst/*.c'], posix=True)
avs_reg_sources = [source.replace(srcpath, '${BUILDPATH}') for source in avs_reg_sources]
avs_stub_sources = []
avs_fwk_sources = []
non_island_reg_sources= []
island_reg_sources = []

if 'USES_AUDIO_IN_ISLAND' in env:
    non_island_reg_sources,island_reg_sources = env.IslandFilter(avs_reg_sources)
    non_island_stub_sources,island_stub_sources = env.IslandFilter(avs_stub_sources)
    if 'USES_AVS_LIBRARY_BUILDER' in env:
        env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME,
        [non_island_reg_sources, non_island_stub_sources, avs_fwk_sources], PACK_SRC=True)
    get_island_lib = env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME+'_island',
                                       [island_reg_sources,island_stub_sources, avs_fwk_sources], PACK_SRC=True)

else:
    env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER','AUDIOLITE_LIBS'], '${BUILDPATH}/'+LIBNAME,
      [avs_reg_sources, avs_stub_sources, avs_fwk_sources], PACK_SRC=True)
