'''
/*==============================================================================
@file posal.scons
@brief 
==============================================================================*/
'''

Import('env')
import os

#-------------------------------------------------------------------------------
# Make all warnings into errors
#-------------------------------------------------------------------------------

if 'CSMD_COSIM' in env:
  env.Append(CFLAGS = '-DCSMD_COSIM')
  env.Append(CPPFLAGS = '-DCSMD_COSIM')
  
env.Append(CFLAGS = '-Wunused-variable')

if 'USES_ENABLE_FUNCTION_SECTIONS' in env:
   env.Append(CFLAGS = '-ffunction-sections')

core_public_apis = [
   'DEBUGTOOLS',
   'KERNEL',
   'POWER',
   'SERVICES',
   'DAL',
   'SYSTEMDRIVERS'
   ]
if "AUDIOSSMODE" in env:
    core_public_apis.append("DLMGR_API")
platform_public_apis = [
    'RTLD',
    'STDDEF',  # idl dependency
    'QAIC',  # idl -> .h
    'PLATFORM_FS',
    'A1STD',
    'HAPSDK',
    ]   

qdsp6_public_apis = [
    'QDSP6'
    ]

env.RequirePublicApi(qdsp6_public_apis, area='qdsp6')
env.RequirePublicApi(core_public_apis, area='core')
env.RequirePublicApi(platform_public_apis, area='platform')
env.RequirePublicApi('DATA_LOGGING_QDI_CLIENT', area='avs')
env.RequirePublicApi('DATA_LOGGING_QDI_CLIENT', area='avs_spf')
env.RequireRestrictedApi('AVS')
env.RequireProtectedApi('AVS')
env.RequirePrivateApi('POSAL')

env.PublishPrivateApi('POSAL',[
   '${AVS_ROOT}/platform/posal/inc',
   '${AVS_FOLDER_ROOT}/driver/platform/qurt/src',
   '${AVS_ROOT}/platform/posal/src/generic',
   '${AVS_ROOT}/platform/posal/inc/private/',
   '${AVS_FOLDER_ROOT}/driver/platform/qurt/src/private/',
   '${AVS_FOLDER_ROOT}/driver/platform/qurt/src/hexagon/',
   '${AVS_FOLDER_ROOT}/driver/platform/qurt/src/${TGT_SPECIFIC_FOLDER}/heap/',   
   ])


if "AUDIOSSMODE" in env:
    env.RequirePublicApi('POWER_CPM', area='core')
    env.RequirePublicApi('POWER_UNPA', area='core')
    env.RequirePublicApi('SERVICES', area='core')
    env.Append(CPPDEFINES="THREAD_PRIO_HIGH=31")
    env.RequireRestrictedApi(['AVS','SHARED_LIBRARY_INC_PATHS'])
else:
    env.Append(CPPDEFINES="THREAD_PRIO_HIGH=255")


# RTLD functions not defined in audioss
if "AUDIOSSMODE" not in env:
    env.Append(CFLAGS=" -DDL_INFO_DEFINED ")
    env.Append(CPPFLAGS=" -DDL_INFO_DEFINED ")

#-------------------------------------------------------------------------------
# Setup source PATH
#-------------------------------------------------------------------------------
SRCPATH = ".."
LIBNAME = 'posal'
LIBNAME_ROOT = 'posal_root'
LIBNAME_PRIVATE = 'posal_private'
LIBNAME_PRIVATE_ROOT = 'posal_private_root'

env.VariantDir('${BUILDPATH}', SRCPATH, duplicate=0)

srcpath = env.RealPath(SRCPATH, posix=True)


# Generate regular source file list
avs_reg_sources = env.GlobSourceFiles(['src/generic/*.cpp', 'src/generic/*.c'], SRCPATH,posix=True)



# Source list for AUDIOSSMODE. To be removed once all utils are split into audioss and generic
if 'AUDIOSSMODE' in env:
  audioss_sources = ['src/generic/posal_bufpool.c',
                     'src/generic/posal_bufpool_island.c',
                     'src/generic/posal_data_log_island.c',
                     'src/generic/posal_channel.c',
                     'src/generic/posal_channel_island.c',
                     'src/generic/posal_queue.c',
                     'src/generic/posal_queue_island.c',
                     'src/generic/posal_signal.c',
                     'src/generic/posal_signal_island.c',
                     'src/generic/posal_std.c',
                     'src/generic/posal_thread_prio.c',
                     'src/generic/posal_thread_profiling.c',
                     'src/generic/posal_err_fatal.c',
                     ]
  avs_reg_sources = env.GlobSourceFiles(audioss_sources, SRCPATH,posix=True)

avs_stub_sources = []

avs_reg_sources = [source.replace(srcpath, '${BUILDPATH}') for source in avs_reg_sources]
avs_stub_sources = [source.replace(srcpath, '${BUILDPATH}') for source in avs_stub_sources]
avs_fwk_sources = []
non_island_reg_sources= []
island_reg_sources = []



if 'USES_AUDIO_IN_ISLAND' in env:
    non_island_reg_sources,island_reg_sources = env.IslandFilter(avs_reg_sources)
    non_island_stub_sources,island_stub_sources = env.IslandFilter(avs_stub_sources)
    if 'USES_AVS_LIBRARY_BUILDER' in env:
        env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME,
        [non_island_reg_sources, non_island_stub_sources, avs_fwk_sources], PACK_SRC=True)
    get_island_lib = env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER'], '${BUILDPATH}/'+LIBNAME+'_island', [island_reg_sources,island_stub_sources, avs_fwk_sources], PACK_SRC=True)
    
else:
    env.AddAvsLibrary(['AVS_ADSP','AVS_ADSP_USER','AUDIOLITE_LIBS'], '${BUILDPATH}/'+LIBNAME,
      [avs_reg_sources, avs_stub_sources, avs_fwk_sources], PACK_SRC=True)


#env.AddLibrary(['AVS_ADSP','AVS_ADSP_USER',,'AUDIOLITE_LIBS' 'CORE_QDSP6_SENSOR_SW'], '${BUILDPATH}/'+LIBNAME, avs_reg_sources)

